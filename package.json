{
  "name": "kliniva-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Kliniva AI Projesi — klinikler için çok kiracılı, çok şubeli klinik operasyon ve CRM SaaS",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:bundle": "vitest run --config vitest.bundle.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:inspect": "tsx --conditions=react-server scripts/db-inspect.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "env:init": "tsx scripts/env-init.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build && npm run test:bundle",
    "db:app-role": "tsx --conditions=react-server scripts/db-app-role.ts",
    "security:check-key": "tsx --conditions=react-server scripts/check-encryption-key.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
