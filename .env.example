# Kliniva AI — örnek ortam değişkenleri. Gerçek değerleri .env.local içine yazın (Git'e girmez).

# Mevcut Neon PostgreSQL — yeni veritabanı OLUŞTURULMAZ. İki ayrı bağlantı:
#
# Uygulama çalışma anı: Neon POOLED host (…-pooler…), en az yetkili rol kliniva_app.
# Yoksa `npm run db:app-role` migration bağlantısından türetip ekler.
DATABASE_URL=
#
# Migration / yönetim: Neon DIRECT (unpooled) host, şema sahibi rol (ör. neondb_owner).
# Uygulama bu bağlantıyı ASLA kullanmaz.
MIGRATION_DATABASE_URL=
#
# kliniva_app parolası — `npm run db:app-role` üretir (TLS ile Neon'a iletilir, hiçbir yere yazdırılmaz).
KLINIVA_APP_DB_PASSWORD=

# AES-256-GCM alan şifreleme anahtarı: 32 bayt, base64. Üretmek için: npm run env:init
APP_ENCRYPTION_KEY=

# Uygulamanın dış adresi (origin/CSRF kontrolü ve TOTP issuer için)
APP_ORIGIN=http://localhost:3000

# Yalnızca geliştirme seed'i (npm run db:seed) — gerçek parola kullanmayın
SEED_TENANT_SLUG=demo-klinik
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
